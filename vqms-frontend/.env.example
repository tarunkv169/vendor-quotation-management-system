# Copy to .env.local and adjust. Only public URLs belong here - never passwords, keys or secrets.

# Production: full gateway URL (e.g. https://api.example.com). Leave empty in development:
# the Vite dev server proxies /api to VITE_DEV_PROXY_TARGET.
VITE_API_GATEWAY_URL=

# Dev server proxy target (the running API Gateway).
VITE_DEV_PROXY_TARGET=http://localhost:18080

# Optional per-service overrides. Empty = go through the gateway (recommended).
# Direct URLs only work when that service allows the browser origin (CORS) - normally only the gateway does.
VITE_IDENTITY_SERVICE_URL=
VITE_VENDOR_SERVICE_URL=
VITE_PROCUREMENT_SERVICE_URL=
VITE_QUOTATION_SERVICE_URL=
VITE_DOCUMENT_SERVICE_URL=
VITE_AI_EXTRACTION_SERVICE_URL=
VITE_VALIDATION_SERVICE_URL=
VITE_COMPARISON_SERVICE_URL=
VITE_RECOMMENDATION_SERVICE_URL=
VITE_APPROVAL_SERVICE_URL=
VITE_NOTIFICATION_SERVICE_URL=
VITE_AUDIT_SERVICE_URL=
VITE_REPORTING_SERVICE_URL=

# Feature flags - mirror the backend flags. false = the related actions are hidden.
VITE_FEATURE_DOCUMENT_STORAGE=false   # backend document-service S3_ENABLED
VITE_FEATURE_AI_EXTRACTION=false      # backend ai-extraction-service LLM_ENABLED
