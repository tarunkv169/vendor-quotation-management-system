# ===================== Application =====================
APP_NAME=ai-extraction-service
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PORT=8090

# ===================== Security =====================
# Same HMAC secret and algorithm as the Identity Service (never commit real values).
JWT_SECRET=change-me-to-the-identity-service-secret-min-32-chars
JWT_ALGORITHM=HS512
JWT_ROLE_CLAIM=role
JWT_USER_ID_CLAIM=userId
# Identity used when this service calls Document Service (role INTERNAL_SERVICE).
SERVICE_USER_ID=00000000-0000-0000-0000-00000000a1e0
SERVICE_TOKEN_TTL_SECONDS=300

# ===================== Database =====================
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/extraction_db

# ===================== RabbitMQ =====================
# false = no broker: the API runs extractions in-process and does not publish events (worker not needed).
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_PREFETCH=1
MESSAGE_MAX_RETRIES=3
MESSAGE_RETRY_DELAY_MS=30000

# ===================== Document Service =====================
DOCUMENT_SERVICE_BASE_URL=http://localhost:8083
# Hosts allowed for presigned download URLs (SSRF protection). Add your S3 host in production.
ALLOWED_DOWNLOAD_HOSTS=["localhost","127.0.0.1","s3.ap-south-1.amazonaws.com"]
HTTP_CONNECT_TIMEOUT_SECONDS=3
HTTP_READ_TIMEOUT_SECONDS=30

# ===================== Processing limits =====================
MAX_FILE_SIZE_BYTES=20971520
MAX_PDF_PAGES=50
MAX_EXCEL_ROWS=5000
MAX_EXCEL_COLUMNS=60
MAX_LLM_INPUT_CHARS=60000
PROCESSING_TIMEOUT_SECONDS=600

# ===================== OCR (Tesseract) =====================
# Leave empty when tesseract is on PATH (Docker image). Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANGUAGES=eng
OCR_DPI=300
OCR_TIMEOUT_SECONDS=60
OCR_MIN_TEXT_CHARS_PER_PAGE=40

# ===================== LLM =====================
# openai | anthropic
# Feature flag: false = extraction requests are rejected (503); no LLM client is created.
LLM_ENABLED=false
LLM_PROVIDER=openai
# Set the model id for the chosen provider.
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_ATTEMPTS=2
LLM_TEMPERATURE=0

# ===================== Confidence =====================
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_REVIEW_THRESHOLD=0.60
DATE_DAY_FIRST=true
