# Copy to ".env" (same folder as docker-compose.yml) and change the values. Never commit .env.

# ---- Image names: <DOCKER_HUB_USER>/vqms-<service>:<IMAGE_TAG> ----
# Images are built locally by "docker compose up -d --build". Set your Docker Hub user only to publish.
DOCKER_HUB_USER=vqms
IMAGE_TAG=latest

# ---- Shared secrets ----
DB_PASSWORD=change-me
# Must equal the secret the Identity Service signs tokens with (VendorQuotationApplication JwtUtil.SECRET,
# currently hard-coded there); >= 64 bytes for HS512. If they differ, every API call returns 401.
JWT_SECRET=change-me-to-the-identity-secret-at-least-64-characters-long-for-hs512-signing
JWT_ALGORITHM=HS512

# ---- Optional infrastructure (start with: docker compose --profile s3 up) ----
EUREKA_ENABLED=true

# ---- Document storage (LocalStack S3 for local use) ----
# false = uploads/downloads disabled (no S3 needed). true = start the "s3" profile or use real S3.
S3_ENABLED=false
S3_BUCKET=vqms-documents-dev
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ---- AI Extraction LLM ----
# false = extraction disabled (no LLM needed). true = also set LLM_MODEL and LLM_API_KEY.
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=

# ---- Email (notification-service) ----
EMAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

